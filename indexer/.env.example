# Required
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/minidex?sslmode=disable
# From contracts/deployments/11155111.json
FACTORY_ADDRESS=0x...
ARBITRAGE_ADDRESS=0x...
START_BLOCK=0

# Optional
PORT=8080
POLL_INTERVAL=6s
BATCH_SIZE=2000
CONFIRMATIONS=3

# Optional arbitrage bot: set a key for a separate wallet with a little Sepolia ETH for gas.
# It needs no tokens: trades are flash-funded and profit is paid to this wallet.
BOT_PRIVATE_KEY=
BOT_INTERVAL=15s
BOT_MIN_PROFIT_BPS=10
